{
  "name": "dsh-desktop-reasoning-slider",
  "version": "1.1.0",
  "description": "A DSH Desktop plugin for selecting and diagnosing published model reasoning efforts.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation"] }
  }
}
